{
  "name": "music-overlayer",
  "productName": "Music Overlayer",
  "version": "1.2.0",
  "description": "Always-on-top now-playing overlay for Windows with a built-in equalizer. Follows music apps and browser tabs only.",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "ITX",
  "homepage": "https://github.com/itxxxx/Music-Overlayer",
  "repository": {
    "type": "git",
    "url": "https://github.com/itxxxx/Music-Overlayer.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "demo": "cross-env MUSIC_OVERLAYER_DEMO=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:portable": "electron-vite build && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "framer-motion": "14.9.1",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
